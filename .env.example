# PostgreSQL connection (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI provider keys — all OPTIONAL. With none set, Rosy runs on the
# built-in free smart engine forever. Add ANY ONE to enable a real LLM:
# Free key at https://console.groq.com (recommended, very fast)
GROQ_API_KEY=
# Free key at https://aistudio.google.com (~1,500 free requests/day)
GEMINI_API_KEY=
# OPENAI_API_KEY=
